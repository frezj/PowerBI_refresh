# Copy to .env and fill in. Do not commit .env.
PBI_TENANT_ID=00000000-0000-0000-0000-000000000000
# Comma-separated workspace (group) ids
PBI_WORKSPACE_IDS=00000000-0000-0000-0000-000000000001,00000000-0000-0000-0000-000000000002

# Option 1 (recommended): service principal. Used when PBI_CLIENT_SECRET is set.
PBI_CLIENT_ID=
PBI_CLIENT_SECRET=

# Option 2: user name and password. Does not work with MFA.
# PBI_CLIENT_ID is optional here, default is the public Power BI client id.
PBI_USERNAME=
PBI_PASSWORD=
